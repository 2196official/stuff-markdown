{
  "name": "@2196official/stuff-markdown",
  "version": "0.1.0",
  "description": "Read and write Stuff Markdown, the plain-text format for Tasks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
